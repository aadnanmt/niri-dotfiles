# ============================================
# CYAN (Neon Cyan / Teal)
# #00ffff | #008080 | #004d4d | #050505
# ============================================

[theme]
name=Cyan

# Core colors
accent=#00ffff
text=#00ffff
textDim=#00e6e6
textMuted=#008080

# General Colors
logo=#00ffff
header=#00ffff
footer=#008080
help=#00e6e6
link=#00ffff
nowplaying=#00ffff
playbackstatus=#004d4d

# Playlist View
playlist.rownum=#008080
playlist.title=#00e6e6
playlist.playing=#00ffff

# Track View
trackview.title=#00ffff
trackview.artist=#00ffff
trackview.album=#00e6e6
trackview.year=#008080
trackview.time=#00ffff
trackview.visualizer=#00ffff
trackview.lyrics=#00e6e6

# Library View
library.artist=#00ffff
library.album=#00e6e6
library.track=#00e6e6
library.enqueued=#00ffff
library.playing=#00ffff

# Search
search.label=#00ffff
search.query=#00e6e6
search.result=#00e6e6
search.enqueued=#00ffff
search.playing=#00ffff

# Progress
progress.filled=#00ffff
progress.empty=#004d4d
progress.elapsed=#00ffff

# Status
status.info=#00ffff
status.warning=#e6e600
status.error=#ff4444
status.success=#00ffff
