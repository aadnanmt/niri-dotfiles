{
  "layer": "top",
  "position": "top",
  "modules-left": ["group/launcher"],

  "modules-center": ["clock", "custom/player", "custom/weather"],

  "modules-right": [
    "pulseaudio",
    "custom/uptime",
    "backlight",
    "battery",
    "network",
    "cpu",
    "memory",
    "custom/updates",
    "custom/podman",
    "custom/lock",
    "custom/power"
  ],

  "group/launcher": {
    "orientation": "horizontal",
    "modules": ["custom/arch"]
  },

  "custom/arch": {
    "format": "󰣇 ",
    "tooltip": false,
    "on-click": "~/.config/fuzzel/launcher.sh"
  },

  "clock": {
    "timezone": "Asia/Jakarta",
    "tooltip": false,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "󰃰 {:%Y-%m-%d %H:%M:%S}",
    "interval": 1
  },

  "network": {
    "format-wifi": "{icon} {signalStrength}%  {bandwidthDownBits}",
    "format-ethernet": "󰈀  {bandwidthDownBits}",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "interval": 3,
    // "min-length": 20,
    "tooltip": false
  },

  "cpu": {
    "interval": 1,
    "tooltip": false,
    "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]
  },

  "memory": {
    "interval": 15,
    "tooltip": false,
    "format": "  {used:0.1f}G/{total:0.1f}G"
  },

  "custom/uptime": {
    "format": "󰅐 {}",
    "interval": 60,
    "tooltip": false,
    "exec": "awk '{d=int($1/86400); h=int(($1%86400)/3600); m=int(($1%3600)/60)} d>0{printf \"%dd %dh\", d, h; next} h>0{printf \"%dh %dm\", h, m; next} {printf \"%dm\", m}' /proc/uptime"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "tooltip": false,
    "format-muted": "",
    "format-icons": {
      "default": ["", "", "", "", " "],
      "headphone": ["", "", "", "", ""]
    },
    "on-click": "pavucontrol"
  },

  "custom/power": {
    "tooltip": false,
    "on-click": "~/.config/fuzzel/powermenu.sh &",
    "format": "⏻"
  },

  "custom/podman": {
    "format": "{}",
    "return-type": "json",
    "interval": 10,
    "exec": "/home/nan/.config/waybar/scripts/docker-stats/docker-stats",
    "tooltip": true
  },

  "custom/weather": {
    "format": "{}",
    "tooltip": false,
    "interval": 1800,
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json"
  },
  "custom/player": {
    "format": "{icon} {text}",
    "return-type": "json",
    "interval": 1,
    "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} - {{title}}\", \"alt\": \"{{status}}\", \"tooltip\": \"{{playerName}}: {{markup_escape(title)}}\"}' 2>/dev/null || echo '{\"text\": \"\", \"alt\": \"stopped\"}'",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "max-length": 10,
    "tooltip": false
  },

  "custom/updates": {
    "format": " {}",
    "interval": 3600,
    "exec": "paru -Qua 2>/dev/null | wc -l | tr -d ' '",
    "exec-if": "paru -Qua 2>/dev/null | grep -q .",
    "tooltip": true,
    "on-click": "kitty -e paru -Syu"
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": {
      "charging": ["󰢜", "󰂅", "󰂋", "󰂊", "󰂈", "󰂉", "󰂊", "󰂋"],
      "discharging": ["󰂎", "󰁺", "󰁼", "󰁾", "󰁿", "󰂂", "󰂀", "󰂁"]
    },
    "interval": 30,
    "tooltip": false
  },

  "backlight": {
    "format": "󰃟 {percent}%",
    "interval": 1,
    "tooltip": false
  },

  "include": ["~/.config/waybar/scripts/modules.json"]
}
