{
  "layer": "bottom",
  "position": "top",
  "margin-top": 0,
  "margin-left": 0,
  "margin-bottom": 0,
  "reload_style_on_change": true,
  "fixed-center": true,
  "height": 36,
  "passthrough": false,
  "margin-right": 0,
  "exclusive-zone": -1,
  "modules-left": ["group/launcher"],

  "modules-center": ["clock", "custom/player", "custom/weather"],

  "modules-right": [
    "pulseaudio",
    "custom/uptime",
    "backlight",
    "battery",
    "network",
    "cpu",
    "memory",
    "custom/lock",
    "custom/power",
  ],

  "group/launcher": {
    "orientation": "horizontal",
    "modules": ["custom/arch"],
  },

  "custom/arch": {
    "format": "󰣇 ",
    "on-click": "~/.config/fuzzel/launcher.sh",
  },

  "clock": {
    "timezone": "Asia/Jakarta",
    "tooltip": true,
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "format": "󰃰 {:%Y-%m-%d %H:%M:%S}",
    "interval": 1,
  },

  "network": {
    "format-wifi": "{icon} {signalStrength}%  {bandwidthDownBits}",
    "format-ethernet": "󰈀  {bandwidthDownBits}",
    "format-disconnected": "󰤮",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
    "interval": 3,
    "tooltip": true,
    "tooltip-format": "WiFi: {essid}\nIP: {ipaddr}\nDown: {bandwidthDownBits}\nUp: {bandwidthUpBits}",
    "tooltip-format-disconnected": "Disconnected",
  },

  "cpu": {
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "CPU Usage",
    "format": "  {icon0}{icon1}{icon2}{icon3} {usage:>2}%",
    "format-icons": ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"],
  },

  "memory": {
    "interval": 15,
    "tooltip": true,
    "tooltip-format": "Memory Usage",
    "format": "  {used:0.1f}G/{total:0.1f}G",
  },

  "custom/uptime": {
    "format": "󰅐 {}",
    "interval": 60,
    "tooltip": true,
    "tooltip-format": "System Uptime",
    "exec": "awk '{d=int($1/86400); h=int(($1%86400)/3600); m=int(($1%3600)/60)} d>0{printf \"%dd %dh\", d, h; next} h>0{printf \"%dh %dm\", h, m; next} {printf \"%dm\", m}' /proc/uptime",
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "tooltip": true,
    "tooltip-format": "Volume: {volume}%\nClick to open mixer",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", "", "", " "],
      "headphone": ["", "", "", "", ""],
    },
    "on-click": "pavucontrol",
  },

  "custom/lock": {
    "format": "󰌾",
    "tooltip": true,
    "tooltip-format": "Lock Screen",
    "on-click": "swaylock -c 050505",
  },

  "custom/power": {
    "tooltip": true,
    "tooltip-format": "Power Menu",
    "on-click": "~/.config/fuzzel/powermenu.sh &",
    "format": "⏻",
  },
  "custom/weather": {
    "format": "{}",
    "tooltip": true,
    "tooltip-format": "Weather",
    "interval": 1800,
    "exec": "~/.config/waybar/scripts/weather.sh",
    "return-type": "json",
  },
  "custom/player": {
    "format": "{icon} {text}",
    "return-type": "json",
    "interval": 1,
    "exec": "playerctl -a metadata --format '{\"text\": \"{{artist}} - {{title}}\", \"alt\": \"{{status}}\", \"tooltip\": \"{{playerName}}: {{markup_escape(title)}}\"}' 2>/dev/null || echo '{\"text\": \"\", \"alt\": \"stopped\"}'",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "max-length": 10,
    "tooltip": true,
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": {
      "charging": ["󰢜", "󰂅", "󰂋", "󰂊", "󰂈", "󰂉", "󰂊", "󰂋"],
      "discharging": ["󰂎", "󰁺", "󰁼", "󰁾", "󰁿", "󰂂", "󰂀", "󰂁"],
    },
    "interval": 30,
    "tooltip": true,
    "tooltip-format": "Battery: {capacity}%\nTime: {timeTo}",
  },

  "backlight": {
    "format": "󰃟 {percent}%",
    "interval": 1,
    "tooltip": true,
    "tooltip-format": "Backlight: {percent}%",
  },
}
