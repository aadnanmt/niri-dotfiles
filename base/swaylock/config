# ~/.config/swaylock/config

# Based UI
ignore-empty-password
font=JetBrainsMono NF Semibold

# Dimension & Indicator 
indicator-radius=100
indicator-thickness=7

# Background
color=050505

# Inside Ring
inside-color=00000000
inside-clear-color=00000000
inside-ver-color=00000000
inside-wrong-color=00000000

# Indicator Keypress
key-hl-color=58a6ff
bs-hl-color=f85149
caps-lock-key-hl-color=58a6ff
caps-lock-bs-hl-color=f85149

# Outer Ring
ring-color=484f58
ring-clear-color=58a6ff
ring-ver-color=58a6ff
ring-wrong-color=f85149

# Text Inside
text-color=f0f6fc
text-clear-color=58a6ff
text-ver-color=58a6ff
text-wrong-color=f85149

# Other Security Setting
show-failed-attempts
