# =============================================================================
#  GITHUB-DARK-DEFAULT THEME
# =============================================================================

# Fish colors
set -g fish_color_command 58a6ff
set -g fish_color_param c9d1d9
set -g fish_color_keyword bc8cff
set -g fish_color_quote 3fb950
set -g fish_color_redirection 76e3ea
set -g fish_color_error f85149
set -g fish_color_end d29922
set -g fish_color_comment 484f58
set -g fish_color_match --background=484f58
set -g fish_color_search_match --background=484f58
set -g fish_color_operator 58a6ff
set -g fish_color_escape 76e3ea
set -g fish_color_autosuggestion 484f58

# FZF github-dark-default style
set -gx FZF_DEFAULT_OPTS "--color=bg+:#161b22,bg:#050505,spinner:#58a6ff,hl:#f85149,fg:#c9d1d9,header:#3fb950,info:#58a6ff,pointer:#58a6ff,marker:#58a6ff,fg+:#f0f6fc,prompt:#58a6ff,hl+:#f85149"
