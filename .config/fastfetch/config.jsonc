{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch_small",
    "color": {
      "1": "cyan",
    },
    "padding": {
      "top": 1,
      "left": 2,
    },
  },
  "display": {
    "separator": " ➜  ",
    "color": {
      "keys": "cyan",
      "title": "cyan",
    },
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": " ",
      "keyColor": "cyan",
    },
    {
      "type": "os",
      "key": "󰣇 ",
      "keyColor": "cyan",
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "cyan",
    },
    {
      "type": "cpu",
      "key": " ",
      "keyColor": "cyan",
      "format": "{1}"
    },
    {
      "type": "shell",
      "key": " ",
      "keyColor": "cyan",
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "cyan",
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "cyan",
    },
    {
      "type": "uptime",
      "key": "󱎫 ",
      "keyColor": "cyan",
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "cyan",
    },
    "break",
    {
      "type": "colors",
      "symbol": "circle",
    },
  ],
}
