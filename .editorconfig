root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.sh]
indent_size = 2
continuation_indent_size = 4
shell_variant = bash

[*.fish]
indent_size = 2

[*.kdl]
indent_size = 2

[*.{json,jsonc}]
indent_size = 2

[*.{css,html}]
indent_size = 2

[Makefile]
indent_style = tab
